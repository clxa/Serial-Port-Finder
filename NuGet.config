<?xml version="1.0" encoding="utf-8"?>
<!--
  让 NuGet 把包缓存放到项目内的 packages\ 文件夹（而不是用户目录），
  这样整个文件夹拷到离线机器后，restore/build 不需要联网。
  注意：在线机器上加新包时，仍会从 nuget.org 下载（未修改源配置）。
  不要这个行为了，删除本文件即可恢复默认（全局缓存）。
-->
<configuration>
  <config>
    <add key="globalPackagesFolder" value="packages" />
  </config>
</configuration>
